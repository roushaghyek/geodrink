# Copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* at build time,
# so never put secrets here: anything EXPO_PUBLIC_ ships to every player.

# Base URL of the Weathr Cloudflare Worker (worker/). Serves /weather and the
# online party rooms. The OpenWeather key is a Worker secret, not an app setting:
#   cd worker && npx wrangler secret put OPENWEATHER_API_KEY
EXPO_PUBLIC_WEATHR_API_URL=

# Legacy name for the same Worker, still read as a fallback.
# EXPO_PUBLIC_WEATHR_PARTY_SERVER_URL=

# Set to 1 to force clearly-labelled demo weather (local dev without a Worker).
# Dev builds use demo weather automatically when no URL is set.
# EXPO_PUBLIC_WEATHR_DEMO_WEATHER=1
